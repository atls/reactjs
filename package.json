{
  "name": "reactjs",
  "private": true,
  "license": "BSD 3-Clause",
  "type": "module",
  "workspaces": [
    "packages/**/*"
  ],
  "lint-staged": {
    "*.{yml,yaml,json,graphql,md}": "yarn format",
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "yarn format",
      "yarn lint"
    ],
    "*.{ts,tsx}": "yarn typecheck",
    "*.{test,spec}.{ts,tsx}": "yarn test unit"
  },
  "resolutions": {
    "@emotion/react": "11.9.3"
  },
  "dependencies": {
    "@emotion/react": "11.9.3",
    "csstype": "3.1.2"
  },
  "devDependencies": {
    "@atls/raijin": "1.1.1",
    "@types/node": "22.10.1"
  },
  "packageManager": "yarn@4.18.0"
}
